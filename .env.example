# --- Required in production ---------------------------------------------
# Signs every session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- AI assistant (optional) --------------------------------------------
# Enables the Ask AI button (search-grounded answers with citations).
ANTHROPIC_API_KEY=
#ASSISTANT_MODEL=claude-opus-5

# --- Agent access -------------------------------------------------------
# Bearer token accepted on machine-readable surfaces (llms.txt,
# llms-full.txt, /<slug>.md, /api/mcp, /api/search) so AI agents can read
# the docs without a browser session. Generate: openssl rand -hex 24
DOCS_AGENT_TOKEN=smilify-agent-dev-token
# Role for token requests: member (default) or admin.
#DOCS_AGENT_ROLE=member

# --- Descope SSO (optional) ---------------------------------------------
# Setting DESCOPE_PROJECT_ID embeds the Descope Flow sign-in on /login.
# The entire sign-in UX (MFA, passkeys, magic links, social) is configured
# in the Descope console — no code changes needed here.
#
# One-time Descope console setup: add this deployment's origin (e.g.
# https://docs.internal) to the project's approved domains so the embedded
# flow is allowed to run.
DESCOPE_PROJECT_ID=

# Descope Flow to embed on the login page.
#DESCOPE_FLOW_ID=sign-up-or-in

# Where Descope is hosted (change for EU/self-hosted tenants).
#DESCOPE_BASE_URL=https://api.descope.com

# Session-JWT claim that carries role names.
#DESCOPE_ROLES_CLAIM=roles

# Descope roles that map to the docs "admin" role (comma-separated).
#DESCOPE_ADMIN_ROLES=admin,docs-admin

# Emails always granted docs admin, regardless of Descope roles.
#DESCOPE_ADMIN_EMAILS=shaumik@echelonai.com
