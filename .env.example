# --- Required in production ---------------------------------------------
# Signs every session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL of this deployment (used for OAuth redirect URIs).
APP_URL=http://localhost:3000

# --- Descope SSO (optional) ---------------------------------------------
# Setting DESCOPE_PROJECT_ID enables the "Continue with Descope SSO" button.
# The docs app talks plain OIDC to Descope; register the redirect URI
#   ${APP_URL}/api/auth/descope/callback
# in Descope (Applications -> your OIDC app -> Redirect URLs).
DESCOPE_PROJECT_ID=

# OIDC client_id if you use a dedicated Descope application; defaults to the
# project ID (Descope's default OIDC app).
#DESCOPE_CLIENT_ID=

# Only needed if the Descope app is configured as a confidential client.
# PKCE is always used, so a public client works without a secret.
#DESCOPE_CLIENT_SECRET=

# Where Descope is hosted (change for EU/self-hosted tenants).
#DESCOPE_BASE_URL=https://api.descope.com

# ID-token claim that carries role names.
#DESCOPE_ROLES_CLAIM=roles

# Descope roles that map to the docs "admin" role (comma-separated).
#DESCOPE_ADMIN_ROLES=admin,docs-admin

# Emails always granted docs admin, regardless of Descope roles.
#DESCOPE_ADMIN_EMAILS=shaumik@echelonai.com
